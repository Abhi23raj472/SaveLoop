# Copy this file to .env for local use. Never commit .env.
# All values are optional locally. Set SAVELOOP_SECRET_KEY in production.

# Signs download links. Use a long random string (e.g. python -c "import secrets; print(secrets.token_urlsafe(32))").
SAVELOOP_SECRET_KEY=

# Set to 1 when running behind a reverse proxy (Render, Nginx).
SAVELOOP_TRUST_PROXY=0

# Optional Netscape-format cookies file for yt-dlp (keep it out of git).
# SAVELOOP_COOKIES_FILE=/path/to/cookies.txt
